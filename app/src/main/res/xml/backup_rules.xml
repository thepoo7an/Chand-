<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto-backup rules for Android 11 and below (API < 31). Kept in sync with
   `data_extraction_rules.xml`, which governs Android 12+. Only user preferences are
   backed up; the regenerable `files/history_cache/` and APK update cache stay local.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
</full-backup-content>
