<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      User-visible state lives in Jetpack DataStore (`files/datastore/chand_prefs.preferences_pb`),
      not in SharedPreferences. The `file` domain entry below is what actually carries theme,
      language, pins, watchlist, comparison selection and price alerts across restore/transfer.
      `sharedpref` is kept for legacy installs that still have a preferences file.
    -->
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
